{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "http.server", "8791", "--bind", "127.0.0.1", "--directory", "artifacts/site"],
      "port": 8791
    },
    {
      "name": "workbench-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "nemotron-challenge", "ui", "--port", "8790"],
      "port": 8790
    },
    {
      "name": "workbench-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ui", "run", "dev"],
      "port": 5173
    },
    {
      "name": "video-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "video", "run", "dev", "--", "--no-open", "--port=3000"],
      "port": 3000
    }
  ]
}
